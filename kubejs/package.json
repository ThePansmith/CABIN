{
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "eslint": "^9.18.0",
        "prettier": "^3.6.2"
    },
    "dependencies": {
        "@stylistic/eslint-plugin-js": "^2.13.0",
        "@typescript-eslint/utils": "^8.21.0"
    },
    "scripts": {
        "lint": "eslint --cache . && prettier --config ./.prettierrc.json --ignore-path ./.prettierignore --ignore-path ../.gitignore --check .",
        "lint:fix": "eslint --cache --fix . && prettier --config ./.prettierrc.json --ignore-path ./.prettierignore --ignore-path ../.gitignore --write .",
        "lint:ci": "eslint . && prettier --config ./.prettierrc.json --ignore-path ./.prettierignore --ignore-path ../.gitignore --check ."
    }
}
